# Copy this file to `.env` and fill in the values.
# NEVER commit your real .env — it is gitignored on purpose.

# SQLite database file (relative to the prisma/ folder).
# For local development, leave as-is; `npm run db:push` creates it.
DATABASE_URL="postgresql://neondb_owner:npg_Pmr5UcN9GsVf@ep-cool-wave-b1rrjx8i-pooler.c-5.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Secret used to sign login tokens. For local dev any long random
# string is fine. Generate one with:  openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
    
# Port the API listens on. The frontend dev server proxies /api here.
PORT=5000

NODE_ENV=development

# Where uploaded files are stored (relative to backend/).
UPLOAD_DIR="./uploads"

# Running / Production API URL
API_URL="https://apitr.amariaerp.org/"
APP_URL="https://apitr.amariaerp.org/"

# --- Optional ---
# Push notifications use Firebase. They are OFF by default and the app
# runs fine without them. To enable, ask the project owner for the
# Firebase service-account credentials and configuration.

